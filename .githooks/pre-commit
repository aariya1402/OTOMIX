#!/usr/bin/env bash
# .githooks/pre-commit
# Pre-commit hook to abort if unrelated files are staged.
# Prevents dirty commits in parallel agent sessions (GOTCHA-HIST-002).

set -euo pipefail

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only)

if [[ -z "$STAGED_FILES" ]]; then
    echo -e "${GREEN}No staged files. Commit allowed.${NC}"
    exit 0
fi

# Define allowed file patterns (files that can be safely committed)
# These are the file types/paths that are expected to be modified in normal development
ALLOWED_PATTERNS=(
    # Source code
    "packages/*/src/**"
    "packages/*/test/**"
    "tools/**"
    # Documentation
    "Docs/**/*.md"
    "Docs/**/*.ps1"
    # Configuration
    "*.json"
    "*.yaml"
    "*.yml"
    "*.toml"
    "*.config.js"
    "*.config.ts"
    # Build/CI
    ".github/**"
    ".githooks/**"
    # Lock files (sometimes need updates)
    "pnpm-lock.yaml"
)

# Function to check if a file matches any allowed pattern
is_allowed() {
    local file="$1"
    for pattern in "${ALLOWED_PATTERNS[@]}"; do
        # Convert glob to regex
        local regex="^${pattern//\*/.*}$"
        regex="${regex//\?/.}"
        if [[ "$file" =~ $regex ]]; then
            return 0
        fi
    done
    return 1
}

# Check each staged file
UNRELATED_FILES=()
for file in $STAGED_FILES; do
    if ! is_allowed "$file"; then
        UNRELATED_FILES+=("$file")
    fi
done

if [[ ${#UNRELATED_FILES[@]} -gt 0 ]]; then
    echo -e "${RED}ERROR: Unrelated files are staged for commit!${NC}" >&2
    echo -e "${YELLOW}The following files are not in the allowed patterns:${NC}" >&2
    for f in "${UNRELATED_FILES[@]}"; do
        echo -e "  ${RED}$f${NC}" >&2
    done
    echo -e "${YELLOW}Please unstage these files or add them to .gitignore if they are build artifacts.${NC}" >&2
    echo -e "${YELLOW}Allowed patterns: ${ALLOWED_PATTERNS[*]}${NC}" >&2
    exit 1
fi

# Check for hard-coded branch names in commit message (if commit message file exists)
if [[ -f "$1" ]]; then
    COMMIT_MSG=$(cat "$1")
    if echo "$COMMIT_MSG" | grep -qE '(main|master|develop|feature/|hotfix/|release/)' && ! echo "$COMMIT_MSG" | grep -qE '^(feat|fix|chore|docs|refactor|test|build|ci|perf|style|revert)'; then
        echo -e "${RED}WARNING: Commit message may contain hard-coded branch name.${NC}" >&2
        echo -e "${YELLOW}Commit message: $COMMIT_MSG${NC}" >&2
    fi
fi

echo -e "${GREEN}Pre-commit checks passed.${NC}"
exit 0