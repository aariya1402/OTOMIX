{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Cloud Code: Build Skaffold",
      "type": "shell",
      "command": "skaffold",
      "args": ["build", "--file=${workspaceFolder}/skaffold.yaml"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Cloud Code: Deploy to Kubernetes",
      "type": "shell",
      "command": "skaffold",
      "args": ["deploy", "--file=${workspaceFolder}/skaffold.yaml", "--default-repo=gcr.io/${env:GOOGLE_CLOUD_PROJECT}"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Cloud Code: Run Skaffold Dev",
      "type": "shell",
      "command": "skaffold",
      "args": ["dev", "--file=${workspaceFolder}/skaffold.yaml", "--port-forward"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Cloud Code: Deploy to Cloud Run",
      "type": "shell",
      "command": "gcloud",
      "args": ["run", "deploy", "${input:serviceName}", "--image=gcr.io/${env:GOOGLE_CLOUD_PROJECT}/${input:serviceName}", "--region=us-central1", "--platform=managed", "--allow-unauthenticated"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Cloud Code: Build and Push Docker Image",
      "type": "shell",
      "command": "docker",
      "args": ["build", "-t", "gcr.io/${env:GOOGLE_CLOUD_PROJECT}/${input:imageName}:${input:tag}", "."],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Cloud Code: Push Docker Image",
      "type": "shell",
      "command": "docker",
      "args": ["push", "gcr.io/${env:GOOGLE_CLOUD_PROJECT}/${input:imageName}:${input:tag}"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Cloud Code: View Kubernetes Logs",
      "type": "shell",
      "command": "kubectl",
      "args": ["logs", "-f", "${input:podName}", "-n", "${input:namespace}"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Cloud Code: Port Forward Service",
      "type": "shell",
      "command": "kubectl",
      "args": ["port-forward", "svc/${input:serviceName}", "${input:localPort}:${input:remotePort}", "-n", "${input:namespace}"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "serviceName",
      "description": "Kubernetes service name",
      "type": "promptString",
      "default": "my-service"
    },
    {
      "id": "namespace",
      "description": "Kubernetes namespace",
      "type": "promptString",
      "default": "default"
    },
    {
      "id": "podName",
      "description": "Pod name to view logs",
      "type": "promptString"
    },
    {
      "id": "localPort",
      "description": "Local port for port forwarding",
      "type": "promptString",
      "default": "8080"
    },
    {
      "id": "remotePort",
      "description": "Remote port for port forwarding",
      "type": "promptString",
      "default": "8080"
    },
    {
      "id": "imageName",
      "description": "Docker image name",
      "type": "promptString",
      "default": "my-app"
    },
    {
      "id": "tag",
      "description": "Docker image tag",
      "type": "promptString",
      "default": "latest"
    }
  ]
}