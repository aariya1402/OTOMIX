{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "react": ["../packages/ui/node_modules/@types/react/index.d.ts"],
      "react/*": ["../packages/ui/node_modules/@types/react/*"],
      "react-dom": ["../packages/ui/node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["../packages/ui/node_modules/@types/react-dom/*"]
    },
    "typeRoots": ["../packages/ui/node_modules/@types", "../node_modules/@types"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": ["node_modules", "../node_modules"]
}
