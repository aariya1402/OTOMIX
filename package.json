{
    "name": "otomix",
    "version": "0.0.1",
    "description": "OTOMIX monorepo with 9 packages",
    "private": true,
    "scripts": {
    "cucumber:generate": "tsx tools/scripts/generate-authz-feature.ts",
    "cucumber:authz": "tsx tools/scripts/generate-authz-feature.ts && cucumber-js --import tsx --require features/support/*.ts --require features/step_definitions/*.ts --tags @authz",
        "build": "pnpm -r build",
        "test": "vitest run",
        "lint": "pnpm -r lint",
        "format": "pnpm -r format"
    },
    "keywords": [
        "otomix",
        "monorepo"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@cucumber/cucumber": "^13.3.0",
        "@types/supertest": "^7.2.1",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.0.0",
        "eslint-config-prettier": "^9.1.2",
        "fast-check": "^4.10.2",
        "madge": "^8.0.0",
        "mermaid": "^12.3.0",
        "pnpm": "^8.0.0",
        "prettier": "^3.0.0",
        "supertest": "^7.3.2",
        "tsx": "^4.0.0",
        "typescript": "^5.0.0",
        "vite": "^6.0.0",
        "vitest": "^3.0.0"
    }
}