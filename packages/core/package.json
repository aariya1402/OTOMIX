{
    "private": true,
    "name": "@otomix/core",
    "version": "0.0.1",
    "description": "core package for OTOMIX platform",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        },
        "./pipeline/enrichment": {
            "types": "./dist/pipeline/enrichment.d.ts",
            "import": "./dist/pipeline/enrichment.js",
            "require": "./dist/pipeline/enrichment.js"
        },
        "./transition": {
            "types": "./dist/transition/index.d.ts",
            "import": "./dist/transition/index.js",
            "require": "./dist/transition/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "test": "vitest run --passWithNoTests",
        "lint": "eslint src --ext .ts",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "keywords": [
        "otomix",
        "core"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@otomix/contracts": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@vitest/ui": "^1.0.0",
        "typescript": "^5.0.0",
        "vitest": "^1.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}